# Django
DEBUG=true
SECRET_KEY=dev-only-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Banco: PostgreSQL em Docker/produção. Deixe comentado para usar SQLite no dev.
# DATABASE_URL=postgres://sepa:sepa@localhost:5432/sepa
POSTGRES_DB=sepa
POSTGRES_USER=sepa
POSTGRES_PASSWORD=sepa

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT (segundos)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# IA
ML_MODEL_PATH=ml/modelo_sepa.joblib

# Produção / Docker (use valores reais fora do repositório)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
DB_CONN_MAX_AGE=60
